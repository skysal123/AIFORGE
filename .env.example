# Copy this file to .env and fill in real values for SMTP-backed contact form.
AIFORGE_ENV=development
SECRET_KEY=change-me-in-production

# Mail (optional in dev — enquiry just gets logged if blank)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
CONTACT_EMAIL=aiforgetechno@gmail.com
