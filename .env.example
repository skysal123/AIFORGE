# Copy this file to ".env" (git-ignored) and fill in real values.
# On Render, set these in Dashboard → Service → Environment instead.

AIFORGE_ENV=development
SECRET_KEY=change-me-in-production

# Database — defaults to a local sqlite file if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Mail (Gmail + App Password) ----------------------------------------------
# Port 587 STARTTLS can be unreliable from Render's IP range.
# If Gmail blocks you, switch to MAIL_PORT=465 + MAIL_USE_SSL=true.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# CONTACT_EMAIL=you@gmail.com

# Mail (SendGrid — recommended for Render) ---------------------------------
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-sendgrid-api-key
# CONTACT_EMAIL=you@yourdomain.com
